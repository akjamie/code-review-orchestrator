+package com.example.billing;
+
+import java.math.BigDecimal;
+
+public class TieredDiscountCalculator {
+
+    public BigDecimal calculateDiscount(BigDecimal amount, int loyaltyYears) {
+        if (amount == null || amount.compareTo(BigDecimal.ZERO) <= 0) {
+            return BigDecimal.ZERO;
+        }
+        if (loyaltyYears >= 5) {
+            return amount.multiply(BigDecimal.valueOf(0.20));
+        } else if (loyaltyYears >= 2) {
+            return amount.multiply(BigDecimal.valueOf(0.10));
+        }
+        return BigDecimal.ZERO;
+    }
+}
