# =============================================================================
# Environment variables for the Code Review Orchestrator
# =============================================================================
# Copy this file to .env and fill in your real values.
# .env is in .gitignore — it will NOT be committed.
# =============================================================================

# AI model for the specialist agents and synthesizer
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# GitHub PAT — must have repo + pull_requests scopes
# Also used by the GitHub MCP server (passed as GITHUB_PERSONAL_ACCESS_TOKEN)
GITHUB_TOKEN=ghp_your-github-personal-access-token-here

# Webhook HMAC secret (set on GitHub Webhook settings page)
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# --- Optional Overrides ---

# Override the model used by all agents (default: deepseek-chat)
# MODEL_NAME=deepseek-chat

# Override the model used specifically by the MCP review agent
# MCP_MODEL_NAME=deepseek-chat

# --- Polling Monitor (disabled by default) ---
# Enable background API polling instead of / in addition to webhooks
# POLLING_ENABLED=true
# POLLING_INTERVAL_SECONDS=60

# Comma-separated list of repos to monitor (leave empty for all)
# MONITORED_REPOS=owner/repo1,owner/repo2