# =============================================================================
# Environment variables for the Code Review Orchestrator
# =============================================================================
# Copy this file to .env and fill in your real values.
# .env is in .gitignore — it will NOT be committed.
# =============================================================================

# AI model for the specialist agents and synthesizer
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# GitHub PAT — must have repo + pull_requests scopes
# Also used by the GitHub MCP server (passed as GITHUB_PERSONAL_ACCESS_TOKEN)
GITHUB_TOKEN=ghp_your-github-personal-access-token-here

# Webhook HMAC secret (set on GitHub Webhook settings page)
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# --- Optional Overrides ---

# Override the model used by all agents (default: deepseek-chat)
# MODEL_NAME=deepseek-chat

# Override the model used specifically by the MCP review agent
# MCP_MODEL_NAME=deepseek-chat

# Context7 API Key (Optional — get a free key from context7.com to access higher rate limits)
# CONTEXT7_API_KEY=your-context7-api-key-here

# --- Polling Monitor (disabled by default) ---
# Enable background API polling instead of / in addition to webhooks
# POLLING_ENABLED=true
# POLLING_INTERVAL_SECONDS=60

# Comma-separated list of repos to monitor (leave empty for all)
# MONITORED_REPOS=owner/repo1,owner/repo2

# --- Langfuse Monitoring (via standard OpenTelemetry env vars) ---
# Endpoint: your local Langfuse instance OTLP ingest path
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3000/api/public/otel
# Headers: comma-separated key=value pairs (no quotes around the whole value)
# Generate auth: echo -n "pk-lf-xxxx:sk-lf-xxxx" | base64
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(pk-lf-xxxx:sk-lf-xxxx)>,x-langfuse-ingestion-version=4
# Protocol must be http/protobuf (Langfuse does NOT support gRPC)
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# --- Proxy Settings ---
# Configure if your network connection to GitHub or DeepSeek is unstable.
# These will be automatically applied to both the Java application and the local Node.js MCP server process.
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890